{
  "manifest_version": 3,
  "name": "New NicoLive Helper Bridge (STSen)",
  "version": "1.0.0",
  "description": "New NicoLive Helper デスクトップアプリとニコニコ生放送を接続する拡張機能です。",
  "browser_specific_settings": {
    "gecko": {
      "id": "stsen-bridge@komatti365.github",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "New NicoLive Helper Bridge"
  },
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "cookies"
  ],
  "host_permissions": [
    "*://live.nicovideo.jp/*",
    "*://live2.nicovideo.jp/*",
    "*://com.nicovideo.jp/*",
    "*://www.nicovideo.jp/*",
    "*://*.nicovideo.jp/*",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://live.nicovideo.jp/watch/*",
        "*://live2.nicovideo.jp/watch/*"
      ],
      "js": [
        "content_scripts/nicolivehelperx.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://live2.nicovideo.jp/create*"
      ],
      "js": [
        "content_scripts/autocreate.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://com.nicovideo.jp/video/*"
      ],
      "js": [
        "libs/utils.js",
        "content_scripts/communityvideo.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://www.nicovideo.jp/tag/*",
        "*://www.nicovideo.jp/search/*",
        "*://www.nicovideo.jp/ranking*"
      ],
      "js": [
        "libs/utils.js",
        "content_scripts/nicovideosearch.js"
      ],
      "run_at": "document_end"
    }
  ]
}